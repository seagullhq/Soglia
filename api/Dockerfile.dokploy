# Dokploy build: UI is built from source and v6 is mounted at runtime,
# because neither ui/dist nor v6/ exist in a fresh Git clone.

FROM golang:1.26-alpine AS go-builder
WORKDIR /src

COPY api/go.mod api/go.sum ./
RUN go mod download

COPY api/cmd ./cmd/
COPY api/internal ./internal/
RUN CGO_ENABLED=0 go build -o /out/profanity-api ./cmd/api

FROM node:22-alpine AS ui-builder
WORKDIR /ui

COPY api/ui/package.json api/ui/package-lock.json ./
RUN npm ci

COPY api/ui/ ./
RUN npm run build

FROM python:3.14-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app
WORKDIR /app

RUN pip install --no-cache-dir \
    numpy==2.5.4 \
    onnxruntime==1.32.0 \
    tokenizers==0.23.3

COPY --from=go-builder /out/profanity-api /app/profanity-api
COPY --from=ui-builder /ui/dist /app/ui/dist
COPY api/worker.py /app/worker.py

EXPOSE 8080
CMD ["/app/profanity-api", "-python", "python", "-worker", "/app/worker.py", "-model", "/app/v6", "-secure-cookie"]
